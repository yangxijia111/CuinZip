<Page
  x:Class="NanaZip.Modern.AboutPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:local="using:NanaZip.Modern"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  IsTextScaleFactorEnabled="False"
  mc:Ignorable="d">
  <!--
    CuinZip P1-1: attribution rewritten to describe the relationship
    correctly (CuinZip is based on NanaZip and 7-Zip) while keeping the
    upstream credits. Link buttons now cover CuinZip, NanaZip and 7-Zip.
  -->
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Padding="24,0">
      <TextBlock
        x:Name="GridTitleTextBlock"
        Margin="0,0,0,12"
        FontSize="24"
        FontWeight="SemiBold"
        Text="[About CuinZip]" />
      <TextBlock IsTextSelectionEnabled="True">
        <Run x:Name="Version" />
        <LineBreak />
        <!--
          CuinZip P1-2: P1-1 新增的 attribution / 版权行接入 resw 本地化,
          键位于 AboutPage.resw(en / zh-Hans),其余语言回退 English。
        -->
        <Run x:Uid="/NanaZip.Modern/AboutPage/AttributionRun" Text="CuinZip is an open source file archiver based on NanaZip and 7-Zip." />
        <LineBreak />
        <Run x:Uid="/NanaZip.Modern/AboutPage/CopyrightRun" Text="© CuinZip Project and Contributors. Based on NanaZip © M2-Team and Contributors and 7-Zip © Igor Pavlov. All rights reserved." />
        <LineBreak />
        <LineBreak />
        <Run x:Name="Content" />
      </TextBlock>
    </StackPanel>
    <Grid Grid.Row="1" Padding="24">
      <Grid.Background>
        <SolidColorBrush Opacity="0.2" Color="{ThemeResource SystemChromeHighColor}" />
      </Grid.Background>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="8" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="8" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="8" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Button
        Grid.Column="0"
        HorizontalAlignment="Stretch"
        Click="GitHubButtonClick"
        Content="GitHub"
        x:Uid="/NanaZip.Modern/AboutPage/GitHubButton" />
      <Button
        Grid.Column="2"
        HorizontalAlignment="Stretch"
        Click="NanaZipWebsiteButtonClick"
        Content="NanaZip.org"
        x:Uid="/NanaZip.Modern/AboutPage/NanaZipWebsiteButton" />
      <Button
        Grid.Column="4"
        HorizontalAlignment="Stretch"
        Click="SevenZipWebsiteButtonClick"
        Content="7-Zip.org"
        x:Uid="/NanaZip.Modern/AboutPage/SevenZipWebsiteButton" />
      <Button
        Grid.Column="6"
        HorizontalAlignment="Stretch"
        Click="CancelButtonClick"
        Content="Close"
        x:Uid="/NanaZip.Modern/AboutPage/CloseButton" />
    </Grid>
  </Grid>
</Page>
