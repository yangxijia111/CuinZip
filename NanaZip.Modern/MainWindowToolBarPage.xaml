<Page
  x:Class="NanaZip.Modern.MainWindowToolBarPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:local="using:NanaZip.Modern"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  IsTextScaleFactorEnabled="False"
  Loaded="PageLoaded"
  mc:Ignorable="d">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="auto" />
      </Grid.ColumnDefinitions>
      <!--
        CuinZip P1-6 / P1-6.1: the toolbar exposes the high-frequency
        actions with icon + text labels (DefaultLabelPosition="Right"
        keeps the 48px toolbar height). Low-frequency commands
        (Copy / Move / Info / Benchmark / About / full menu) stay in
        the More menu; Settings is a dedicated gear button on the right;
        Home reopens the Start page (quick actions + recent archives).
        Extract / Test are context-aware: they only make sense inside
        an archive or when the selection consists of archive files,
        and are hidden otherwise (see UpdateContextState).
      -->
      <CommandBar
        Grid.Column="0"
        HorizontalAlignment="Left"
        Background="Transparent"
        DefaultLabelPosition="Right"
        IsDynamicOverflowEnabled="False"
        IsOpen="False">
        <AppBarButton
          x:Name="HomeButton"
          x:Uid="/NanaZip.Modern/MainWindowToolBarPage/HomeButton"
          AutomationProperties.Name="[Home]"
          Click="HomeButtonClick"
          Icon="Home"
          Label="[Home]"
          ToolTipService.ToolTip="[Home]" />
        <AppBarButton
          x:Name="AddButton"
          AutomationProperties.Name="[Add]"
          Click="AddButtonClick"
          Icon="Add"
          Label="[Add]"
          ToolTipService.ToolTip="[Add]" />
        <AppBarButton
          x:Name="ExtractButton"
          AutomationProperties.Name="[Extract]"
          Click="ExtractButtonClick"
          Icon="MoveToFolder"
          Label="[Extract]"
          ToolTipService.ToolTip="[Extract]" />
        <AppBarButton
          x:Name="TestButton"
          AutomationProperties.Name="[Test]"
          Click="TestButtonClick"
          Icon="Accept"
          Label="[Test]"
          ToolTipService.ToolTip="[Test]" />
        <AppBarButton
          x:Name="DeleteButton"
          AutomationProperties.Name="[Delete]"
          Click="DeleteButtonClick"
          Icon="Delete"
          Label="[Delete]"
          ToolTipService.ToolTip="[Delete]" />
        <AppBarButton
          x:Name="MoreButton"
          x:Uid="/NanaZip.Modern/MainWindowToolBarPage/MoreButton"
          AutomationProperties.Name="[More]"
          Click="MoreButtonClick"
          Icon="More"
          Label="[More]"
          ToolTipService.ToolTip="[More]" />
      </CommandBar>
      <!--
        CuinZip P1-6: dedicated gear entry for Settings (opens the Modern
        settings window, same command as the former Options button).
      -->
      <AppBarButton
        x:Name="SettingsButton"
        Grid.Column="2"
        Margin="0,0,8,0"
        VerticalAlignment="Center"
        AutomationProperties.Name="[Settings]"
        Click="OptionsButtonClick"
        Icon="Setting"
        Label="[Settings]"
        ToolTipService.ToolTip="[Settings]" />
    </Grid>
  </Grid>
</Page>
