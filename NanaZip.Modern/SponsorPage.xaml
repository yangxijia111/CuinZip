<Page
  x:Class="NanaZip.Modern.SponsorPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:local="using:NanaZip.Modern"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  IsTextScaleFactorEnabled="False"
  mc:Ignorable="d">
  <!--
    CuinZip P1-1: this page used to be the NanaZip Sponsor Edition
    purchase dialog. CuinZip does not sell licenses and does not accept
    purchases on behalf of NanaZip, so it is now a plain
    "Open Source Projects" page. The class and file names are kept for
    ABI stability (K7ModernShowSponsorDialog).
  -->
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock
      Grid.Row="0"
      Margin="16,16,16,4"
      HorizontalAlignment="Center"
      FontSize="24"
      FontWeight="SemiBold"
      Text="Open Source Projects" />

    <TextBlock
      Grid.Row="1"
      Margin="32,0,32,8"
      HorizontalAlignment="Center"
      TextWrapping="Wrap"
      TextAlignment="Center"
      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
      Text="CuinZip is an open source project based on NanaZip and 7-Zip. CuinZip itself is free and does not sell any license." />

    <Grid Grid.Row="2" Padding="32,8">
      <Grid.RowDefinitions>
        <RowDefinition Height="56" />
        <RowDefinition Height="8" />
        <RowDefinition Height="56" />
        <RowDefinition Height="8" />
        <RowDefinition Height="56" />
      </Grid.RowDefinitions>
      <Button
        Grid.Row="0"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        HorizontalContentAlignment="Stretch"
        AutomationProperties.Name="CuinZip on GitHub"
        Click="CuinZipGitHubButtonClick">
        <StackPanel Margin="16,0" Orientation="Horizontal">
          <SymbolIcon Margin="0,0,16,0" Symbol="Link" />
          <TextBlock Text="CuinZip on GitHub (yangxijia111/CuinZip)" />
        </StackPanel>
      </Button>
      <Button
        Grid.Row="2"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        HorizontalContentAlignment="Stretch"
        AutomationProperties.Name="NanaZip on GitHub"
        Click="NanaZipGitHubButtonClick">
        <StackPanel Margin="16,0" Orientation="Horizontal">
          <SymbolIcon Margin="0,0,16,0" Symbol="Link" />
          <TextBlock Text="NanaZip on GitHub (M2Team/NanaZip)" />
        </StackPanel>
      </Button>
      <Button
        Grid.Row="4"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        HorizontalContentAlignment="Stretch"
        AutomationProperties.Name="7-Zip Official Website"
        Click="SevenZipWebsiteButtonClick">
        <StackPanel Margin="16,0" Orientation="Horizontal">
          <SymbolIcon Margin="0,0,16,0" Symbol="Link" />
          <TextBlock Text="7-Zip Official Website (7-zip.org)" />
        </StackPanel>
      </Button>
    </Grid>

    <TextBlock
      Grid.Row="3"
      Margin="16,0,16,12"
      HorizontalAlignment="Center"
      TextWrapping="Wrap"
      TextAlignment="Center"
      FontSize="12"
      Foreground="{ThemeResource TextFillColorTertiaryBrush}"
      Text="NanaZip © M2-Team and Contributors. 7-Zip © Igor Pavlov." />
  </Grid>
</Page>
