<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
  x:Class="NanaZip.Modern.StatusBarTemplate"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:NanaZip.Modern">

  <Style
    x:Key="StatusBarTextBlockStyle"
    BasedOn="{StaticResource CaptionTextBlockStyle}"
    TargetType="TextBlock">
    <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <!--
    CuinZip P1-2: 状态栏信息层级。
    左侧(TextPrimary):项目数 / 已选择数量与大小,占满剩余宽度。
    右侧(TextArchive):压缩包信息,按内容自适应,为空时不显示。
    不再展示焦点项大小 / 日期,避免状态栏堆满。
  -->
  <Style x:Key="DefaultStatusBarStyle" TargetType="local:StatusBar">
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="local:StatusBar">
          <Grid
            Margin="{TemplateBinding Margin}"
            Padding="{TemplateBinding Padding}"
            Background="{TemplateBinding Background}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
              Grid.Column="0"
              VerticalAlignment="Center"
              Style="{StaticResource StatusBarTextBlockStyle}"
              Text="{x:Bind TextPrimary, Mode=OneWay}" />
            <!--
              压缩包信息为空时 TextBlock 不渲染任何内容,
              因此不使用分隔线,避免空态下残留孤立分隔线。
            -->
            <TextBlock
              Grid.Column="2"
              x:Name="ArchiveTextBlock"
              Margin="8,0,0,0"
              VerticalAlignment="Center"
              Style="{StaticResource StatusBarTextBlockStyle}"
              Text="{x:Bind TextArchive, Mode=OneWay}" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style BasedOn="{StaticResource DefaultStatusBarStyle}" TargetType="local:StatusBar" />

</ResourceDictionary>
