<?xml version="1.0" encoding="utf-8"?>
<!--
  PROJECT:    NanaZip
  FILE:       NanaZip.Project.props
  PURPOSE:    MSBuild Properties for NanaZip Common Properties

  LICENSE:    The MIT License

  MAINTAINER: MouriNaruto (Kenji.Mouri@outlook.com)
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildThisFileDirectory)NanaZip.Project.Version.props" />
  <PropertyGroup>
    <NanaZipBuildPreviewRelease Condition="'$(NanaZipBuildPreviewRelease)' == ''">true</NanaZipBuildPreviewRelease>
    <NanaZipBuildWithSanitizers Condition="'$(NanaZipBuildWithSanitizers)' == ''">false</NanaZipBuildWithSanitizers>
  </PropertyGroup>
  <PropertyGroup>
    <NanaZipBuildNumberDate Condition="'$(NanaZipBuildNumberDate)' == ''">$([System.DateTime]::Today.ToString('yyyy-MM-dd'))</NanaZipBuildNumberDate>
    <!-- CuinZip 自有版本号:Major.Minor.Build.Revision(Build 见 Version.props,
         不再使用上游"距 2021-08-31 天数"构建号规则) -->
    <MileProjectVersion>$(NanaZipMajorVersion).$(NanaZipMinorVersion).$(NanaZipBuildNumber).$(NanaZipRevisionNumber)</MileProjectVersion>
    <MileProjectVersionTag Condition="'$(NanaZipBuildPreviewRelease)' == 'false'">, version $(NanaZipDisplayVersion)</MileProjectVersionTag>
    <MileProjectVersionTag Condition="'$(MileProjectVersionTag)' == ''">Preview, version $(NanaZipDisplayVersion)</MileProjectVersionTag>
  </PropertyGroup>
</Project>